# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development, and add both variables in
# Vercel → Project Settings → Environment Variables.
#
# NEVER commit a real .env file. NEVER put these values in any file that is
# deployed to the browser, and never paste a live credential into chat, a
# screenshot, or a git commit.
# ---------------------------------------------------------------------------

# Required. Supabase → Project Settings → Database → Connection string → URI.
#
# Format (session pooler, port 5432):
#   postgresql://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:5432/postgres
#
# The <project-ref> is the 20-character value in your project URL
# (supabase.com/dashboard/project/<project-ref>). It is CASE-SENSITIVE and
# PostgreSQL reports it as "ENOTFOUND tenant/user" if it is wrong.
#
# The password must be URL-encoded: @ -> %40, # -> %23, / -> %2F, : -> %3A
DATABASE_URL=

# Required. The public origin of the deployment, with no trailing slash.
# Used for canonical tags, og:url, og:image and sitemap.xml.
# Production example: https://www.kodsol.com
# Local example:     http://localhost:3000
SITE_URL=

# Optional. Set to "sample" to serve bundled demonstration posts when the
# database is unreachable, instead of showing visitors an error page.
#
# The sample posts are clearly labelled on the page and force noindex, so they
# can never be indexed or mistaken for real articles. This is a stopgap for when
# DATABASE_URL is not configured yet. Leave it unset (or "off") in production
# once the real database works, so a future outage shows an honest error rather
# than placeholder content.
#
#   BLOG_FALLBACK=sample
BLOG_FALLBACK=

# --- Optional tuning -------------------------------------------------------

# Max pooled connections per warm serverless instance. Keep low.
# DB_POOL_MAX=3

# Server-side statement timeout in milliseconds.
# DB_STATEMENT_TIMEOUT_MS=8000

# Set to "disable" only if your host does not support TLS. Leave unset for
# Supabase — encrypted transport is the default and should stay on.
# DB_SSL=disable
